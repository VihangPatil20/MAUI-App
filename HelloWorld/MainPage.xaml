<ContentPage
    x:Class="HelloWorld.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="18">

            <Label
                Text="Incoming Call Capture"
                FontSize="28"
                FontAttributes="Bold" />

            <Label
                Text="This app stores incoming caller numbers locally on this phone."
                FontSize="16" />

            <Button
                Text="Enable Call Capture"
                Clicked="OnEnableCallScreeningClicked" />

            <Label
                x:Name="StatusLabel"
                Text="Call screening has not been checked yet."
                FontSize="14" />

            <Label
                Text="Latest caller"
                FontSize="20"
                FontAttributes="Bold" />

            <Label
                x:Name="LatestNumberLabel"
                Text="No caller captured yet"
                FontSize="24"
                FontAttributes="Bold" />

            <Button
                Text="Refresh Calls"
                Clicked="OnRefreshCallsClicked" />

            <Label
                Text="Recent captured calls"
                FontSize="20"
                FontAttributes="Bold" />

            <VerticalStackLayout
                x:Name="CallsLayout"
                Spacing="10" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
